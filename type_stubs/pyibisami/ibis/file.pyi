from _typeshed import Incomplete
from pyibisami.ibis.parser import parse_ibis_file as parse_ibis_file
from traits.api import Event, HasTraits, List

class IBISModel(HasTraits):
    pin_: Incomplete
    pin_rlcs: Incomplete
    model: Incomplete
    pins = List
    models = List
    alert = Event
    def get_models(self, mname): ...
    def get_pins(self): ...
    def __init__(self, ibis_file_name: str) -> None: ...
    def info(self): ...
    def __call__(self) -> None: ...
    def default_traits_view(self): ...
    @property
    def ibis_parsing_errors(self): ...
    @property
    def model_dict(self): ...
    @property
    def dll_file(self): ...
    @property
    def ami_file(self): ...
